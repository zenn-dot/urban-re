# Copy to .env and export these in your shell / process manager (the server reads process.env;
# it does not load .env files by itself, to stay dependency-free). All values are optional.

# Port and bind address (default 3000 / 127.0.0.1)
PORT=3000
HOST=127.0.0.1

# SQLite database file (default ./data/urban.db)
DATABASE_PATH=./data/urban.db

# Set to "true" when served over HTTPS so the session cookie gets the Secure flag
COOKIE_SECURE=false

# Extra browser origins allowed to call the API (comma-separated), normally empty
ALLOWED_ORIGINS=
